# === Git Abbreviations ===
abbr -a gb   "git branch"
abbr -a gbd  "git branch -D"
abbr -a gsw  "git switch"
abbr -a gswc "git switch -c"
abbr -a gst  "git status"
abbr -a gpl  "git pull"
abbr -a gps  "git push"

# === eza (ls alternative) Abbreviations ===
abbr -a ll "eza -lAh"
abbr -a lg "eza -lAh --git"
abbr -a lt "eza -lAT"
