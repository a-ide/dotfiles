# Git abbreviations
abbr --add gb      "git branch"
abbr --add gbd     "git branch -D"
abbr --add gsw     "git switch"
abbr --add gswc    "git switch -c"
abbr --add gst     "git status"
abbr --add gpl     "git pull"
abbr --add gps     "git push"
abbr --add gpsup   "gpsu"

abbr -a ll "eza -lAh"
abbr -a lg "eza -lAh --git"
abbr -a lt "eza -lAT"

